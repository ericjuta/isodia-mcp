{
  "version": "",
  "title": "Checkout (synthetic)",
  "description": "A made-up checkout used to show a published walkthrough. No real system is described.",
  "items": [
    {
      "id": "shopper",
      "name": "Shopper",
      "description": "<p>A browser on the checkout page. Holds a session cookie and nothing else.</p>",
      "icon": "browser"
    },
    {
      "id": "cdn",
      "name": "CDN",
      "description": "<p>Serves the checkout page and its scripts. Never caches /api responses.</p>",
      "icon": "cdn"
    },
    {
      "id": "gateway",
      "name": "API gateway",
      "description": "<p>Terminates TLS, checks the session with Identity and routes /api/checkout to the checkout service. Rejects requests without a session before they reach a service.</p>",
      "icon": "gateway"
    },
    {
      "id": "identity",
      "name": "Identity",
      "description": "<p>Sessions and customer accounts. Answers one question for the gateway: who is this?</p>",
      "icon": "key"
    },
    {
      "id": "checkout",
      "name": "Checkout service",
      "description": "<p>Turns a cart into an order: prices it, reserves stock, asks Payments for a charge and writes the order.</p>",
      "icon": "service"
    },
    {
      "id": "cart",
      "name": "Cart store",
      "description": "<p>Baskets keyed by session. Losing it loses a basket, not an order.</p>",
      "icon": "cache"
    },
    {
      "id": "orders",
      "name": "Orders database",
      "description": "<p>Orders and the outbox table, written in one transaction. The source of truth for what was bought.</p>",
      "icon": "database"
    },
    {
      "id": "payments",
      "name": "Payments service",
      "description": "<p>The only component that talks to the payment provider. Every charge carries an idempotency key derived from the order id.</p>",
      "icon": "service"
    },
    {
      "id": "keys",
      "name": "Idempotency keys",
      "description": "<p>Remembers each charge request and its result for 24 hours, so a retried checkout returns the first answer instead of charging again.</p>",
      "icon": "cache"
    },
    {
      "id": "psp",
      "name": "Payment provider",
      "description": "<p>Third party. Authorises cards and wallets, then confirms asynchronously with a signed webhook.</p>",
      "icon": "paymentcard"
    },
    {
      "id": "outbox",
      "name": "Outbox relay",
      "description": "<p>Reads committed rows from the outbox table and publishes them. An event is published only if its order was committed.</p>",
      "icon": "worker"
    },
    {
      "id": "events",
      "name": "Event stream",
      "description": "<p>Order events, retained for seven days so a consumer can replay after an outage.</p>",
      "icon": "stream"
    },
    {
      "id": "fulfilment",
      "name": "Fulfilment worker",
      "description": "<p>Picks, packs and books a courier for each paid order.</p>",
      "icon": "worker"
    },
    {
      "id": "notifier",
      "name": "Notifier",
      "description": "<p>Sends the order confirmation. Safe to run twice: it records which events it has handled.</p>",
      "icon": "bell"
    },
    {
      "id": "courier",
      "name": "Courier",
      "description": "<p>Third party. Collects parcels and returns a tracking number.</p>",
      "icon": "truck"
    },
    {
      "id": "mail",
      "name": "Mail provider",
      "description": "<p>Third party. Delivers transactional email.</p>",
      "icon": "mail"
    }
  ],
